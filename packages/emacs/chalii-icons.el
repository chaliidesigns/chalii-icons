;;;###autoload
(defun chalii-icons-setup ()
  "Install Chalii's file-icon overlay onto nerd-icons.el.
Idempotent: re-running replaces any prior Chalii entries with the
current build.  Call this once after `nerd-icons` is loaded."
  (interactive)
  (dolist (e chalii-icons-extension-icon-alist)
    (setq nerd-icons-extension-icon-alist
          (cons e (assoc-delete-all (car e) nerd-icons-extension-icon-alist))))
  (dolist (e chalii-icons-regexp-icon-alist)
    (setq nerd-icons-regexp-icon-alist
          (cons e (assoc-delete-all (car e) nerd-icons-regexp-icon-alist))))
  (when (called-interactively-p 'interactive)
    (message "chalii-icons: %d ext, %d filename overlays installed"
             (length chalii-icons-extension-icon-alist)
             (length chalii-icons-regexp-icon-alist))))

;;;###autoload
(defun chalii-icons-icon-for-name (name &optional face)
  "Return the propertized Chalii glyph for icon NAME.
Optional FACE overrides the default palette face."
  (apply #'chalii-icons--render name (and face (list :face face))))

(provide 'chalii-icons)
