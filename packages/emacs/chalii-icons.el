(defun chalii-icons--render (name &rest args)
  "Return the Chalii glyph for NAME as a propertized string.
ARGS are passed through from the nerd-icons icon-alist call site; the
`:face` keyword is honored if provided, otherwise the Chalii palette
color from `chalii-icons--glyphs` is used as the foreground."
  (let* ((entry (cdr (assoc name chalii-icons--glyphs)))
         (glyph (or (car entry) "?"))
         (color (cdr entry))
         (face-arg (plist-get args :face))
         (face (or face-arg
                   (and color `(:foreground ,color)))))
    (if face
        (propertize glyph 'face face)
      glyph)))

